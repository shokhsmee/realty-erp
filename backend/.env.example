# Copy to .env and adjust. Never commit the real .env.

# --- Database (async driver) ---
DATABASE_URL=postgresql+asyncpg://realty:realty@localhost:5432/realty

# --- Security ---
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- App ---
ENVIRONMENT=development
# Comma-separated origins allowed by CORS (the React dev server, etc.)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- First admin (used by scripts/seed.py) ---
FIRST_ADMIN_EMAIL=admin@realty.uz
FIRST_ADMIN_PASSWORD=admin12345
FIRST_ADMIN_NAME=System Administrator
